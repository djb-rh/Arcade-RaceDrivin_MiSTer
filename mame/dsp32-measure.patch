 	// get our address spaces
 	space(AS_PROGRAM).cache(m_cache);
 	space(AS_PROGRAM).specific(m_program);
@@ -416,11 +490,13 @@ inline uint32_t dsp32c_device::ROPCODE(offs_t pc)
 
 inline uint8_t dsp32c_device::RBYTE(offs_t addr)
 {
+	rd_dsp32log_mem(addr, 1, false);
 	return m_program.read_byte(addr);
 }
 
 inline void dsp32c_device::WBYTE(offs_t addr, uint8_t data)
 {
+	rd_dsp32log_mem(addr, 1, true);
 	m_program.write_byte(addr, data);
 }
 
@@ -430,6 +506,7 @@ inline uint16_t dsp32c_device::RWORD(offs_t addr)
 	if (!WORD_ALIGNED(addr))
 		osd_printf_error("Unaligned word read @ %06X, PC=%06X\n", addr, PC);
 #endif
+	rd_dsp32log_mem(addr, 2, false);
 	return m_program.read_word(addr);
 }
 
@@ -439,6 +516,7 @@ inline uint32_t dsp32c_device::RLONG(offs_t addr)
 	if (!DWORD_ALIGNED(addr))
 		osd_printf_error("Unaligned long read @ %06X, PC=%06X\n", addr, PC);
 #endif
