+//**************************************************************************
+//  RD_DSP32LOG: measurement hooks for the Race Drivin' FPGA project.
+//  Enabled when the environment variable RD_DSP32LOG names an output file.
+//  Logs opcode usage, memory footprint, instruction rate, PIO traffic.
+//**************************************************************************
+
+#include <cstdlib>
+#include <cstdio>
+#include <cstring>
+#include <string>
+#include <vector>
+
+namespace {
+struct rd_dsp32log_state
+{
+	bool enabled = false;
+	FILE *f = nullptr;
+	uint64_t instructions = 0;
+	uint64_t next_mark = 0;
+	std::vector<uint64_t> op_hist;      // op >> 21 (11 bits)
+	std::vector<uint64_t> op16_hist;    // op >> 16 (16 bits)
+	std::vector<uint64_t> page_rd;      // 1 KiB pages over 24-bit space (16384)
+	std::vector<uint64_t> page_wr;
+	uint64_t rd_count = 0, wr_count = 0;
+	uint64_t pio_rd = 0, pio_wr = 0;
+
+	// RD_DSP32TRACE: per-instruction state deltas for lock-step comparison
+	// with the FPGA core (rd-mister sim/tb_dsp32.sv).  RD_DSP32TRACE_FROM
+	// and RD_DSP32TRACE_COUNT select an instruction window; the first traced
+	// instruction carries the full state and a memory image (<file>.mem).
+	FILE *tf = nullptr;
+	bool trace_enabled = false, tracing = false, trace_started = false;
+	uint64_t trace_from = 0, trace_count = ~0ull, traced = 0;
+	bool trace_arm_dau = false;          // RD_DSP32TRACE_DAU=1: start at the first DAU instruction
+	int depth = 0;                       // execute_one nesting (delay slots)
+	uint32_t t_r[32]; double t_a[4]; uint32_t t_nzc = 0, t_v = 0; uint8_t t_vu = 0; uint64_t t_nz = 0;
+	uint16_t t_pio[9]; int t_lastp = 0;
+	struct wr { uint32_t addr, data; int size; };
+	std::vector<wr> writes;
+};
+rd_dsp32log_state rdlog;
+
+void rd_dsp32log_open()
+{
+	const char *path = std::getenv("RD_DSP32LOG");
+	if (!path || !*path) return;
+	rdlog.f = std::fopen(path, "w");
+	if (!rdlog.f) return;
+	rdlog.enabled = true;
+	rdlog.op_hist.assign(1 << 11, 0);
+	rdlog.op16_hist.assign(1 << 16, 0);
+	rdlog.page_rd.assign(1 << 14, 0);
+	rdlog.page_wr.assign(1 << 14, 0);
+	std::fprintf(rdlog.f, "# RD_DSP32LOG v1\n");
+}
+
+void rd_dsp32trace_open()
+{
+	const char *path = std::getenv("RD_DSP32TRACE");
+	if (!path || !*path) return;
+	rdlog.tf = std::fopen(path, "w");
+	if (!rdlog.tf) return;
+	rdlog.trace_enabled = true;
+	if (const char *v = std::getenv("RD_DSP32TRACE_FROM")) rdlog.trace_from = std::strtoull(v, nullptr, 0);
+	if (const char *v = std::getenv("RD_DSP32TRACE_COUNT")) rdlog.trace_count = std::strtoull(v, nullptr, 0);
+	if (const char *v = std::getenv("RD_DSP32TRACE_DAU")) rdlog.trace_arm_dau = (*v == '1');
+	std::fprintf(rdlog.tf, "# RD_DSP32TRACE v1 from=%llu count=%llu\n",
+		(unsigned long long)rdlog.trace_from, (unsigned long long)rdlog.trace_count);
+}
+
+inline void rd_dsp32trace_write(offs_t addr, int size, uint32_t data)
+{
+	if (rdlog.tracing) rdlog.writes.push_back({addr, data, size});
+}
+
+inline void rd_dsp32log_mem(offs_t addr, int bytes, bool write)
+{
+	if (!rdlog.enabled) return;
+	auto &pages = write ? rdlog.page_wr : rdlog.page_rd;
+	pages[(addr >> 10) & 0x3fff]++;
+	if (write) rdlog.wr_count++; else rdlog.rd_count++;
+}
+
+void rd_dsp32log_close()
+{
+	if (!rdlog.enabled) return;
+	FILE *f = rdlog.f;
+	std::fprintf(f, "SUMMARY instructions=%llu reads=%llu writes=%llu pio_reads=%llu pio_writes=%llu\n",
+		(unsigned long long)rdlog.instructions, (unsigned long long)rdlog.rd_count,
+		(unsigned long long)rdlog.wr_count, (unsigned long long)rdlog.pio_rd,
+		(unsigned long long)rdlog.pio_wr);
+	for (size_t i = 0; i < rdlog.op_hist.size(); i++)
+		if (rdlog.op_hist[i]) std::fprintf(f, "OP11 %03zx %llu\n", i, (unsigned long long)rdlog.op_hist[i]);
+	for (size_t i = 0; i < rdlog.op16_hist.size(); i++)
+		if (rdlog.op16_hist[i]) std::fprintf(f, "OP16 %04zx %llu\n", i, (unsigned long long)rdlog.op16_hist[i]);
+	for (size_t i = 0; i < rdlog.page_rd.size(); i++)
+		if (rdlog.page_rd[i] || rdlog.page_wr[i])
+			std::fprintf(f, "PAGE %06zx rd=%llu wr=%llu\n", i << 10,
+				(unsigned long long)rdlog.page_rd[i], (unsigned long long)rdlog.page_wr[i]);
+	std::fclose(f);
+	rdlog.f = nullptr;
+	rdlog.enabled = false;
+}
+
+void rd_dsp32trace_close()
+{
+	if (!rdlog.tf) return;
+	std::fprintf(rdlog.tf, "# end traced=%llu\n", (unsigned long long)rdlog.traced);
+	std::fclose(rdlog.tf);
+	rdlog.tf = nullptr;
+	rdlog.trace_enabled = rdlog.tracing = false;
+}
+} // anonymous namespace
+
+
 
