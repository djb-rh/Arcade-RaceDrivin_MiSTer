+// Emit one instruction record for RD_DSP32TRACE: the state changes since the
+// previous record (so everything the previous instruction and any host PIO
+// access did, including deferred DAU memory writes just processed), then the
+// instruction about to execute.  Lines:
+//   I <n> <pc> <op>        n = instructions executed before this one
+//   R <idx> <hex>          CAU register m_r[idx] (15 = PC, 26 = DAUC ...)
+//   A <idx> <hex16>        accumulator as IEEE double bits
+//   F <nzc> <v> <vu> <nz>  CAU nzcflags, vflags, DAU VU flags, DAU NZ value (double bits)
+//   P <par> <pare> <pdr> <pdr2> <pir> <pcr> <emr> <esr> <pcw>
+//   L <lastp>              DAU Z-inherits-from-Y pointer register
+//   W <size> <addr> <data> memory write performed since the last record
+//   M <file>               memory image (first record only)
+//   PW/PR <n> <reg> <data> host PIO write / read (from pio_w/pio_r)
+//   X <n>                  device reset
+void dsp32c_device::rd_trace_instruction(uint32_t op)
+{
+	auto &t = rdlog;
+	if (!t.tracing)
+	{
+		if (t.trace_started || t.instructions < t.trace_from) return;
+		// start only where the FPGA core can be initialised from the record:
+		// not in a delay slot, no deferred DAU memory write pending, no
+		// accumulator write still inside the multiplier/flag latency window
+		if (t.depth != 0) return;
+		for (int i = 0; i < 4; i++)
+			if (m_mbufaddr[i] != 1 || m_icount >= m_abufcycle[i] - 3 * 4) return;
+		if (t.trace_arm_dau && ((op >> 21) < 0x100 || (op >> 21) > 0x3ff)) return;
+		t.tracing = t.trace_started = true;
+		std::string memname = std::string(std::getenv("RD_DSP32TRACE")) + ".mem";
+		if (FILE *mf = std::fopen(memname.c_str(), "wb"))
+		{
+			// 8 KiB at 0, 256 KiB at 0x600000, 2 KiB at 0xfff800, little-endian bytes
+			for (uint32_t a = 0; a < 0x2000; a++) std::fputc(m_program.read_byte(a), mf);
+			for (uint32_t a = 0x600000; a < 0x640000; a++) std::fputc(m_program.read_byte(a), mf);
+			for (uint32_t a = 0xfff800; a < 0x1000000; a++) std::fputc(m_program.read_byte(a), mf);
+			std::fclose(mf);
+		}
+		std::fprintf(t.tf, "M %s\n", memname.c_str());
+		// force every field out on the first record
+		for (int i = 0; i < 32; i++) t.t_r[i] = ~m_r[i];
+		for (int i = 0; i < 4; i++) t.t_a[i] = m_a[i] + 1.0;
+		t.t_nzc = ~m_nzcflags; t.t_v = ~m_vflags; t.t_vu = ~m_VUflags; t.t_nz = ~0ull;
+		for (int i = 0; i < 9; i++) t.t_pio[i] = 0xdead;
+		t.t_lastp = -1;
+		t.writes.clear();
+	}
+	std::fprintf(t.tf, "I %llu %06X %08X\n", (unsigned long long)t.instructions, PC, op);
+	for (int i = 0; i < 32; i++)
+		if (m_r[i] != t.t_r[i]) { std::fprintf(t.tf, "R %d %08X\n", i, m_r[i]); t.t_r[i] = m_r[i]; }
+	for (int i = 0; i < 4; i++)
+		if (std::memcmp(&m_a[i], &t.t_a[i], 8) != 0)
+		{
+			uint64_t bits; std::memcpy(&bits, &m_a[i], 8);
+			std::fprintf(t.tf, "A %d %016llX\n", i, (unsigned long long)bits); t.t_a[i] = m_a[i];
+		}
+	uint64_t nzbits; std::memcpy(&nzbits, &m_NZflags, 8);
+	if (m_nzcflags != t.t_nzc || m_vflags != t.t_v || m_VUflags != t.t_vu || nzbits != t.t_nz)
+	{
+		std::fprintf(t.tf, "F %08X %08X %X %016llX\n", m_nzcflags, m_vflags, m_VUflags, (unsigned long long)nzbits);
+		t.t_nzc = m_nzcflags; t.t_v = m_vflags; t.t_vu = m_VUflags; t.t_nz = nzbits;
+	}
+	uint16_t pio[9] = { m_par, m_pare, m_pdr, m_pdr2, m_pir, m_pcr, m_emr, m_esr, m_pcw };
+	if (std::memcmp(pio, t.t_pio, sizeof(pio)) != 0)
+	{
+		std::fprintf(t.tf, "P %04X %02X %04X %04X %04X %04X %04X %04X %04X\n", pio[0], pio[1], pio[2], pio[3], pio[4], pio[5], pio[6], pio[7], pio[8]);
+		std::memcpy(t.t_pio, pio, sizeof(pio));
+	}
+	if (m_lastp != t.t_lastp) { std::fprintf(t.tf, "L %d\n", m_lastp); t.t_lastp = m_lastp; }
+	for (auto &w : t.writes) std::fprintf(t.tf, "W %d %06X %0*X\n", w.size, w.addr, w.size * 2, w.data);
+	t.writes.clear();
+	if (++t.traced >= t.trace_count) { t.tracing = false; rd_dsp32trace_close(); }
+}
+
+
