 	return m_program.read_dword(addr);
 }
 
@@ -448,6 +526,7 @@ inline void dsp32c_device::WWORD(offs_t addr, uint16_t data)
 	if (!WORD_ALIGNED(addr))
 		osd_printf_error("Unaligned word write @ %06X, PC=%06X\n", addr, PC);
 #endif
+	rd_dsp32log_mem(addr, 2, true);
 	m_program.write_word(addr, data);
 }
 
@@ -457,6 +536,7 @@ inline void dsp32c_device::WLONG(offs_t addr, uint32_t data)
 	if (!DWORD_ALIGNED(addr))
 		osd_printf_error("Unaligned long write @ %06X, PC=%06X\n", addr, PC);
 #endif
+	rd_dsp32log_mem(addr, 4, true);
 	m_program.write_dword(addr, data);
 }
 
@@ -485,6 +565,8 @@ void dsp32c_device::set_irq_line(int irqline, int state)
 
 void dsp32c_device::update_pcr(uint16_t newval)
 {
+	if (rdlog.enabled && ((newval ^ m_pcr) & PCR_RESET))
+		std::fprintf(rdlog.f, "PCR t=%.6f reset=%d pc=%06X instr=%llu\n", machine().time().as_double(), (newval & PCR_RESET) ? 1 : 0, PC, (unsigned long long)rdlog.instructions);
 	uint16_t oldval = m_pcr;
 	m_pcr = newval;
 
@@ -691,6 +773,11 @@ void dsp32c_device::pio_w(int reg, int data)
 {
 	uint16_t mask;
 	uint8_t mode;
+	if (rdlog.enabled)
+	{
+		rdlog.pio_wr++;
+		std::fprintf(rdlog.f, "PIOW t=%.6f reg=%d data=%04X pcr=%04X\n", machine().time().as_double(), reg, data & 0xffff, m_pcr);
+	}
 
 	// look up register and mask
 	mode = ((m_pcr >> 8) & 2) | ((m_pcr >> 1) & 1);
@@ -773,6 +860,11 @@ int dsp32c_device::pio_r(int reg)
 {
 	uint16_t mask, result = 0xffff;
 	uint8_t mode, shift = 0;
+	if (rdlog.enabled)
+	{
+		rdlog.pio_rd++;
+		std::fprintf(rdlog.f, "PIOR t=%.6f reg=%d pcr=%04X\n", machine().time().as_double(), reg, m_pcr);
+	}
 
 	// look up register and mask
 	mode = ((m_pcr >> 8) & 2) | ((m_pcr >> 1) & 1);
diff --git a/src/devices/cpu/dsp32/dsp32ops.hxx b/src/devices/cpu/dsp32/dsp32ops.hxx
index 5a02393c..f8a0140b 100644
--- a/src/devices/cpu/dsp32/dsp32ops.hxx
+++ b/src/devices/cpu/dsp32/dsp32ops.hxx
@@ -129,6 +129,17 @@ inline void dsp32c_device::execute_one()
 	op = ROPCODE(PC);
 	m_icount -= 4;  // 4 clocks per cycle
 	PC += 4;
+	if (rdlog.enabled)
+	{
+		rdlog.instructions++;
+		rdlog.op_hist[op >> 21]++;
+		rdlog.op16_hist[op >> 16]++;
+		if (rdlog.instructions >= rdlog.next_mark)
+		{
+			std::fprintf(rdlog.f, "MARK t=%.6f instr=%llu\n", machine().time().as_double(), (unsigned long long)rdlog.instructions);
+			rdlog.next_mark += 100000;
+		}
+	}
 	if (op)
 		(this->*s_dsp32ops[op >> 21])(op);
 }
